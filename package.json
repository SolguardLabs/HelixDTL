{
  "name": "helix-dtl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motor determinista de vault shares y liquidacion por epocas en C.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:c": "node scripts/test-c.mjs",
    "test": "node --test tests/node/*.test.js",
    "test:js": "node --test tests/node/*.test.js",
    "check:js": "node scripts/check-js.mjs",
    "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "audit:prod": "npm audit --omit=dev",
    "ci": "npm run fmt:check && node scripts/build.mjs && npm run test:c && node scripts/check-js.mjs && node --test tests/node/*.test.js && npm run audit:prod && python scripts/verify_release.py"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
